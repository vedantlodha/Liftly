{
  "name": "liftly",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "immer": "^11.1.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "sql.js": "^1.14.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "expo lint",
    "catalog:check": "node --experimental-strip-types --no-warnings scripts/check-catalog.ts",
    "catalog:build": "node --experimental-strip-types --no-warnings scripts/build-catalog.ts",
    "db:verify": "node --experimental-strip-types --experimental-sqlite --no-warnings --import ./scripts/register-hooks.mjs scripts/verify-db.ts",
    "test": "node --test --experimental-strip-types --no-warnings --import ./scripts/register-hooks.mjs \"src/**/*.test.ts\"",
    "android:install": "bash scripts/install-android.sh",
    "apk": "bash scripts/build-apk.sh",
    "icons": "node --experimental-strip-types --no-warnings scripts/build-icons.ts"
  },
  "private": true
}
